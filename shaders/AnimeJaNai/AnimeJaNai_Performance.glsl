//!DESC AnimeJaNai pixel shuffle and crop (2x)
//!HOOK MAIN
//!BIND MAIN
//!BIND AJN50
//!SAVE MAIN
//!WIDTH MAIN.w 2 *
//!HEIGHT MAIN.h 2 *
//!COMPONENTS 4

vec2 AJN50_cell() { return AJN50_size / vec2(4.0, 3.0); }
vec4 read_AJN50(vec2 p, int g) {
    vec2 sz = AJN50_cell();
    if (p.x < 0.0 || p.y < 0.0 || p.x >= sz.x || p.y >= sz.y) return vec4(0.0);
