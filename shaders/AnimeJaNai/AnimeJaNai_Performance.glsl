vec4 hook() {
    vec2 q = floor(MAIN_pos * MAIN_size * 2.0);
    vec2 p = floor(q / 4.0);
    ivec2 phase = ivec2(mod(q, 4.0));
    int k = phase.y * 4 + phase.x;
